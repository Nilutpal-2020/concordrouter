# ConcordRouter Environment Configuration

# Server Port
PORT=8080

# Master Encryption Key for BYOA Provider Credentials (AES-256-GCM)
# Generate a strong 32-byte secret for production
CONCORD_ENCRYPTION_KEY=concord-router-secret-key-32bytes!!

# Database Path (SQLite)
DB_PATH=concordrouter.db

# Optional Postgres Connection (if using Postgres instead of SQLite)
# DATABASE_URL=postgres://concord:concordpassword@localhost:5432/concordrouter?sslmode=disable

# Optional Redis Connection (for distributed session streaming)
# REDIS_URL=redis://localhost:6379/0
